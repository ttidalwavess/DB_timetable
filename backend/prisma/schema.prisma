  created_at       DateTime?          @default(now()) @db.Timestamp(6)
  school           school             @relation(fields: [school_id], references: [school_id], onUpdate: NoAction)
  teacher          teacher[]
  training_program training_program[]

  @@unique([department_name, school_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model lesson {
  lesson_id          Int                @id @default(autoincrement())
  schedule_id        Int
  study_group_id     Int
  subj_id            Int
  assignment_id      Int
  room_id            Int
  slot_id            Int                @db.SmallInt
  lesson_type        String             @db.VarChar(12)
  day_of_week        Int?               @db.SmallInt
  week_parity        String?            @default("BOTH") @db.VarChar(4)
  is_recurring       Boolean            @default(true)
  specific_date      DateTime?          @db.Date
  location_type      String             @default("ROOM") @db.VarChar(10)
  is_transfer        Boolean            @default(false)
  created_at         DateTime?          @default(now()) @db.Timestamp(6)
  teacher_assignment teacher_assignment @relation(fields: [assignment_id], references: [assignment_id], onUpdate: NoAction)
  room               room               @relation(fields: [room_id], references: [room_id], onUpdate: NoAction)
  schedule           schedule           @relation(fields: [schedule_id], references: [schedule_id], onDelete: Cascade, onUpdate: NoAction)
  slot               slot               @relation(fields: [slot_id], references: [slot_id], onUpdate: NoAction)
  study_group        study_group        @relation(fields: [study_group_id], references: [study_group_id], onUpdate: NoAction)
  curriculum_subject curriculum_subject @relation(fields: [subj_id], references: [subj_id], onUpdate: NoAction)
  transfer           transfer[]

  @@index([specific_date], map: "idx_lesson_date")
  @@index([schedule_id, study_group_id, day_of_week, slot_id, week_parity], map: "idx_lesson_group_time")
  @@index([schedule_id, room_id, day_of_week, slot_id, week_parity], map: "idx_lesson_room_time")
  @@index([schedule_id], map: "idx_lesson_schedule")
  @@index([schedule_id, assignment_id, day_of_week, slot_id, week_parity], map: "idx_lesson_teacher_time")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model room {
  room_id     Int        @id @default(autoincrement())
  room_number String     @db.VarChar(20)
  room_type   String     @db.VarChar(20)
  capacity    Int        @db.SmallInt
  building_id Int
  is_online   Boolean    @default(false)
  created_at  DateTime?  @default(now()) @db.Timestamp(6)
  lesson      lesson[]
  building    building   @relation(fields: [building_id], references: [building_id], onUpdate: NoAction)
  transfer    transfer[]

  @@unique([room_number, building_id])
  @@index([building_id], map: "idx_room_building")
  @@index([room_type], map: "idx_room_type")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
