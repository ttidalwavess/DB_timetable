/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model transfer {
  transfer_id        Int       @id @default(autoincrement())
  original_lesson_id Int
  original_date      DateTime  @db.Date
  new_date           DateTime  @db.Date
  new_slot_id        Int       @db.SmallInt
  new_room_id        Int?
  reason             String?   @db.VarChar(200)
  status             String    @default("PENDING") @db.VarChar(10)
  created_at         DateTime? @default(now()) @db.Timestamp(6)
  room               room?     @relation(fields: [new_room_id], references: [room_id], onDelete: NoAction, onUpdate: NoAction)
  slot               slot      @relation(fields: [new_slot_id], references: [slot_id], onDelete: NoAction, onUpdate: NoAction)
  lesson             lesson    @relation(fields: [original_lesson_id], references: [lesson_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([original_lesson_id], map: "idx_transfer_lesson")
  @@index([status], map: "idx_transfer_status")
}
