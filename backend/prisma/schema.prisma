  created_at      DateTime?  @default(now()) @db.Timestamp(6)
  lesson          lesson[]
  schedule        schedule?  @relation("scheduleToschedule", fields: [copied_from_id], references: [schedule_id], onDelete: NoAction, onUpdate: NoAction)
  other_schedule  schedule[] @relation("scheduleToschedule")
  curriculum      curriculum @relation(fields: [curriculum_id], references: [curriculum_id], onUpdate: NoAction)
}

