generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model academic_group {
  group_id           Int              @id @default(autoincrement())
  group_name         String           @unique @db.VarChar(20)
  program_id         Int
  year_of_enrollment Int              @db.SmallInt
  created_at         DateTime?        @default(now()) @db.Timestamp(6)
  training_program   training_program @relation(fields: [program_id], references: [program_id], onUpdate: NoAction)
  study_group        study_group[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model building {
  building_id                                                    Int                 @id @default(autoincrement())
  building_name                                                  String              @unique @db.VarChar(50)
  address                                                        String?             @db.VarChar(200)
  created_at                                                     DateTime?           @default(now()) @db.Timestamp(6)
  building_distance_building_distance_from_building_idTobuilding building_distance[] @relation("building_distance_from_building_idTobuilding")
  building_distance_building_distance_to_building_idTobuilding   building_distance[] @relation("building_distance_to_building_idTobuilding")
  room                                                           room[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model building_distance {
  from_building_id                                      Int
  to_building_id                                        Int
  travel_minutes                                        Int      @db.SmallInt
  building_building_distance_from_building_idTobuilding building @relation("building_distance_from_building_idTobuilding", fields: [from_building_id], references: [building_id], onDelete: Cascade, onUpdate: NoAction)
  building_building_distance_to_building_idTobuilding   building @relation("building_distance_to_building_idTobuilding", fields: [to_building_id], references: [building_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([from_building_id, to_building_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model calendar_day {
  calendar_date DateTime @id @db.Date
  day_of_week   Int      @db.SmallInt
  is_working    Boolean  @default(true)
  day_type      String   @db.VarChar(20)
  week_number   Int      @db.SmallInt
  week_parity   String   @db.VarChar(4)
  holiday_name  String?  @db.VarChar(100)

  @@index([week_number, week_parity], map: "idx_cd_week")
  @@index([is_working, day_of_week], map: "idx_cd_working")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model curriculum {
  curriculum_id      Int                  @id @default(autoincrement())
  program_id         Int
  year_number        Int                  @db.SmallInt
  semester_number    Int                  @db.SmallInt
  created_at         DateTime?            @default(now()) @db.Timestamp(6)
  training_program   training_program     @relation(fields: [program_id], references: [program_id], onUpdate: NoAction)
  curriculum_subject curriculum_subject[]
